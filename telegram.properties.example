# Пример настроек Telegram-бота (этап 5) — мобильный вход.
# Скопируй в telegram.properties и заполни:
#
#   cp telegram.properties.example telegram.properties
#
# Файл не коммитится (см. .gitignore).
#
# Любую настройку можно задать переменной окружения — она имеет приоритет:
#   TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_CHATS, TELEGRAM_POLL_SECONDS


# ── 1. Создать бота ───────────────────────────────────────────────────────
#
# В Telegram найди @BotFather → команда /newbot → придумай имя
# → он выдаст токен вида 1234567890:AAE...
#
# Токен = полный доступ к боту. Не публикуй его и не пересылай.
#
# Вставляй значение БЕЗ кавычек и без пробелов внутри. Программа проверит вид
# токена при запуске и скажет, если что-то не так, — но сам токен показывать
# не будет: это сообщение видно в консоли.

telegram.bot.token=


# ── 2. Разрешить себе писать ──────────────────────────────────────────────
#
# КТО УГОДНО может найти бота и написать ему. Без этого списка твоя система
# заметок была бы открытой формой для любого желающего. Поэтому пустой список
# означает «нельзя НИКОМУ» — не «можно всем».
#
# Свой идентификатор узнать просто: запусти сервер с токеном, но пустым
# списком, напиши боту что угодно — он ответит твоим номером.
# Впиши его сюда и перезапусти.
#
# Несколько чатов — через запятую: 111111111,222222222
#
# Разрешение выдаётся ЧАТУ, а не человеку. Личный чат — это ты один, и обычно
# нужен только он. Но если вписать сюда идентификатор группы (он начинается с
# минуса), писать в твою систему сможет любой участник этой группы.

telegram.allowed.chats=


# ── 3. Запустить ──────────────────────────────────────────────────────────
#
#   java -jar target/second-brain.jar --serve
#
# Бот живёт только в режиме сервера: ему нужно постоянно слушать Telegram,
# а консольный запуск длится секунды. Компьютер должен быть включён —
# заметки и модель local, поэтому обрабатывать сообщения больше некому.


# ── Прочее ────────────────────────────────────────────────────────────────
#
# Сколько секунд держать запрос открытым в ожидании сообщений.
# По умолчанию 30 — сообщения приходят мгновенно, а запросов уходит
# два в минуту вместо непрерывного опроса.
# telegram.poll.seconds=30
