<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Родительский pom Spring Boot даёт согласованные версии сотен библиотек.
      Благодаря ему версии зависимостей ниже не указаны вообще — их подставляет родитель.

      Ветка 4.1 выбрана осознанно: вся ветка 3.x вышла из открытой поддержки 30.06.2026
      и больше не получает патчей безопасности. См. docs/stage-3-plan.md, раздел 8.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.secondbrain</groupId>
    <artifactId>second-brain</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>second-brain</name>
    <description>Единая точка захвата мыслей: пиши/диктуй одной строкой — система сама классифицирует и раскладывает по местам.</description>

    <properties>
        <java.version>21</java.version>
        <main.class>com.secondbrain.App</main.class>
    </properties>

    <dependencies>
        <!--
          JSON-хранилище. Boot 4 работает с Jackson 3 (пакет tools.jackson),
          в котором поддержка java.time встроена — отдельный модуль jsr310 больше не нужен.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          Хранилище SQLite. Берём именно spring-jdbc, а не spring-boot-starter-jdbc:
          нужен только JdbcClient, а стартер притащил бы ещё пул соединений HikariCP
          и автонастройку DataSource. Для встроенной однопользовательской базы пул
          не нужен, а консольный режим должен стартовать быстро.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <!--
          Веб-слой: встроенный сервер Tomcat, разбор JSON, маршрутизация запросов.
          Стартер — это набор: одна строка вместо десятка отдельных зависимостей.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Проверка входящих данных по аннотациям (@NotBlank, @Size) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Официальный SDK Anthropic — умная классификация мыслей (этап 4).
          Приносит с собой Jackson 2; он уживается с нашим Jackson 3,
          потому что это разные пакеты (com.fasterxml против tools.jackson).
        -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.52.0</version>
        </dependency>

        <!--
          Swagger UI: интерактивная документация API по адресу /swagger-ui.html.
          Описание строится из аннотаций контроллеров, поэтому не может отстать
          от кода. Версия указана явно — springdoc не входит в BOM Spring Boot.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Тесты: JUnit, AssertJ, Mockito одним набором -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>second-brain</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      Предохранитель: тесты не должны иметь возможности достучаться
                      до настоящего Notion. Путь к настройкам уводим на заведомо
                      отсутствующий файл, а переменную с токеном гасим пустым значением.
                      Без этого первый же тест, поднимающий полное приложение, начал бы
                      создавать страницы в личном workspace при каждом `mvn test`.
                      Закреплено тестом NotionConfigSafetyTest.
                    -->
                    <systemPropertyVariables>
                        <secondbrain.notion.config>${project.build.directory}/no-notion-config-in-tests.properties</secondbrain.notion.config>
                        <secondbrain.classifier.config>${project.build.directory}/no-classifier-config-in-tests.properties</secondbrain.classifier.config>
                        <secondbrain.telegram.config>${project.build.directory}/no-telegram-config-in-tests.properties</secondbrain.telegram.config>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <NOTION_TOKEN></NOTION_TOKEN>
                        <NOTION_CONFIG_FILE></NOTION_CONFIG_FILE>
                        <!-- Тот же принцип для моделей: тесты не должны обращаться
                             ни к одному провайдеру — ни к платному, ни к бесплатному
                             (лимиты бесплатных тоже исчерпаемы). -->
                        <ANTHROPIC_API_KEY></ANTHROPIC_API_KEY>
                        <GROQ_API_KEY></GROQ_API_KEY>
                        <GEMINI_API_KEY></GEMINI_API_KEY>
                        <SECOND_BRAIN_CLASSIFIER></SECOND_BRAIN_CLASSIFIER>
                        <SECOND_BRAIN_CLASSIFIER_CONFIG></SECOND_BRAIN_CLASSIFIER_CONFIG>
                        <!-- И бот: тест, поднимающий приложение целиком, не должен
                             начать слушать настоящий Telegram. -->
                        <TELEGRAM_BOT_TOKEN></TELEGRAM_BOT_TOKEN>
                        <TELEGRAM_CONFIG_FILE></TELEGRAM_CONFIG_FILE>
                        <!--
                          И тот же принцип для данных: тест, поднимающий приложение
                          целиком, не должен открывать боевую базу с личными заметками.
                          Уводим хранилище в target/, который чистится при сборке.
                        -->
                        <SECOND_BRAIN_DB>${project.build.directory}/test-data/second-brain.db</SECOND_BRAIN_DB>
                        <SECOND_BRAIN_DATA>${project.build.directory}/test-data/notes.json</SECOND_BRAIN_DATA>
                    </environmentVariables>
                </configuration>
            </plugin>

            <!--
              Исполняемый jar: java -jar target/second-brain.jar
              Заменил maven-shade-plugin. Точку входа указываем явно, потому что
              приложение запускается и как консольная программа, и (с шага 6) как сервер.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
