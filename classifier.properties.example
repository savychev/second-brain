# Пример настроек умной классификации (этап 4).
# Скопируй в classifier.properties и заполни:
#
#   cp classifier.properties.example classifier.properties
#
# БЕЗ КЛЮЧА ПРИЛОЖЕНИЕ РАБОТАЕТ. Классификация просто остаётся на правилах —
# ровно как до этапа 4. Ключ добавляет качество, а не работоспособность.
# Файл не коммитится (см. .gitignore).
#
# Любую настройку можно задать переменной окружения — она имеет приоритет:
#   SECOND_BRAIN_CLASSIFIER, GEMINI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY,
#   GEMINI_MODEL, GROQ_MODEL, ANTHROPIC_MODEL, SECOND_BRAIN_CLASSIFIER_TIMEOUT


# ── Кто классифицирует: rules | gemini | groq | anthropic ─────────────────
#
# Не задано — выбирается по наличию ключа: сначала бесплатные (gemini, затем
# groq), и только потом платный anthropic. Нет ни одного — правила.
#
# classifier.provider=gemini


# ── Google Gemini: бесплатный уровень ─────────────────────────────────────
#
# Ключ создаётся на https://aistudio.google.com/apikey — вход обычным
# Google-аккаунтом, карта не нужна. Нажми «Create API key» и скопируй.

gemini.api.key=

# Модель. По умолчанию gemini-3.6-flash — быстрая, входит в бесплатный уровень.
# gemini.model=gemini-3.6-flash


# ── Groq: бесплатный уровень ──────────────────────────────────────────────
#
# Ключ создаётся на https://console.groq.com/keys — карта не нужна.
# Ограничения бесплатного уровня (30 запросов в минуту, 1000 в день)
# для личного инструмента избыточны с большим запасом.

groq.api.key=

# Модель. По умолчанию openai/gpt-oss-20b — из открытых моделей на бесплатном
# уровне она поддерживает СТРОГИЙ режим схемы: ответ гарантированно нужной формы.
# Старшая openai/gpt-oss-120b точнее, но отвечает медленнее.
# groq.model=openai/gpt-oss-20b


# ── Anthropic: платно, лучшее качество ────────────────────────────────────
#
# Ключ создаётся на https://console.anthropic.com/settings/keys
# ВНИМАНИЕ: подписка Claude Pro/Max доступа к API НЕ включает —
# счёт в Console пополняется отдельно.

# anthropic.api.key=
# anthropic.model=claude-opus-5


# ── Общее ─────────────────────────────────────────────────────────────────
#
# Сколько ждать ответа модели, секунд. По умолчанию 8 — с запасом укладывается
# в цель «захват мысли за 10 секунд». Не ответила вовремя — сработают правила.
# classifier.timeout.seconds=8
